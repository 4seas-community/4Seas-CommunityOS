# ---- Database ----
# Local dev database (see docker-compose.yml). Tests use the same URL unless overridden.
DATABASE_URL=postgres://community:community@127.0.0.1:5433/communityos

# ---- App ----
# Public base URL of this app (used for iCal links, claim URLs, etc.)
APP_URL=http://localhost:3000
# Timezone used to interpret venue opening hours (4Seas is in Chiang Mai).
DEFAULT_TIMEZONE=Asia/Bangkok

# ---- Session ----
# Secret used to sign this system's own session JWT (HS256). Change in production.
SESSION_SECRET=dev-only-session-secret-change-me

# ---- CAS (Community Account System) ----
# When CAS_API_URL and CAS_SERVICE_KEY are both set, the real HttpCasClient is used.
# Otherwise MockCasClient is used for local development (no CAS required).
CAS_API_URL=
CAS_SERVICE_KEY=

# ---- 4seasbot outbound feed ----
# Shared secret the bot must present as "Authorization: Bearer <BOT_FEED_TOKEN>".
BOT_FEED_TOKEN=dev-bot-feed-token

# ---- Points (V2 feature flag, default off) ----
# When false, points_per_hour is never charged (points_charged stays 0).
POINTS_ENABLED=false
