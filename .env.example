# ---- Database ----
# Production runs on Cloudflare D1 through the DB binding in wrangler.jsonc.
# Locally (dev scripts and tests) the same SQLite schema is applied to this file
# by node:sqlite, so no database server is needed. Use ":memory:" for a throwaway.
DATABASE_FILE=.data/communityos.db

# ---- Email ----
# console = verification/login links only go to the server log (dev + tests).
# resend  = real delivery through Resend (hello@idoris.ai is the verified domain).
EMAIL_BACKEND=console
# Only needed when EMAIL_BACKEND=resend. Get it from the Resend dashboard.
RESEND_API_KEY=
# What recipients see. The address stays on idoris.ai (the verified domain); the
# name is the community's, because the message speaks for 4Seas, not for iDoris.
EMAIL_FROM=4Seas Community <hello@idoris.ai>
EMAIL_REPLY_TO=hello@idoris.ai
# Branding inside the message: 4Seas leads, iDoris is credited as the provider only.
EMAIL_BRAND_NAME=4Seas Community
EMAIL_BRAND_URL=
EMAIL_LOGO_URL=
EMAIL_PROVIDER_NAME=iDoris AI

# ---- App ----
# Public base URL of this app (used for iCal links, claim URLs, etc.)
APP_URL=http://localhost:3000
# Timezone used to interpret venue opening hours (4Seas is in Chiang Mai).
DEFAULT_TIMEZONE=Asia/Bangkok

# ---- Session ----
# Secret used to sign this system's own session JWT (HS256). Change in production.
SESSION_SECRET=dev-only-session-secret-change-me

# ---- CAS (Community Account System) ----
# When CAS_API_URL and CAS_SERVICE_KEY are both set, the real HttpCasClient is used.
# Otherwise MockCasClient is used for local development (no CAS required).
CAS_API_URL=
CAS_SERVICE_KEY=

# ---- 4seasbot outbound feed ----
# Shared secret the bot must present as "Authorization: Bearer <BOT_FEED_TOKEN>".
BOT_FEED_TOKEN=dev-bot-feed-token

# ---- Points (V2 feature flag, default off) ----
# When false, points_per_hour is never charged (points_charged stays 0).
POINTS_ENABLED=false
